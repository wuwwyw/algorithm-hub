# Copy to .env on each machine and fill in that machine's database password.
# Values are literal. This file is NOT executed as a shell script.
ALGORITHM_HOST=127.0.0.1
ALGORITHM_PORT=8080

ALGORITHM_DB_HOST=127.0.0.1
ALGORITHM_DB_PORT=3306
ALGORITHM_DB_USER=algorithm_app
ALGORITHM_DB_PASSWORD=
ALGORITHM_DB_NAME=algorithm_hub

ALGORITHM_REDIS_HOST=127.0.0.1
ALGORITHM_REDIS_PORT=6379
# Leave both empty for a local Redis without authentication.
# Password-only Redis: set PASSWORD, leave USER empty.
# Redis ACL: set both USER and PASSWORD.
ALGORITHM_REDIS_USER=
ALGORITHM_REDIS_PASSWORD=
